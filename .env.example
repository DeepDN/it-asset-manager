# Environment Configuration for IT Asset Manager

# Application Settings
SECRET_KEY=change-this-to-a-random-secret-in-production
FLASK_ENV=production
FLASK_DEBUG=0

# Database Configuration
DATABASE_URL=postgresql://it_assets_user:it_assets_pass@postgres:5432/it_assets
# For local SQLite: DATABASE_URL=sqlite:///instance/it_assets.db

# Admin User Configuration
ADMIN_PASSWORD=admin123

# Asset Base URL (for QR codes)
ASSET_BASE_URL=http://localhost:5000

# Security Settings
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# PostgreSQL Credentials (for docker-compose.prod.yml)
DB_USER=it_assets_user
DB_PASSWORD=change-this-password

# Email Configuration (for password reset - optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
